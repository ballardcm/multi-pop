<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <formatVersion>7</formatVersion>

    <!-- The Odin 2 has one 1920x1080 display, so every coordinate is a plain fraction of that screen. -->
    <!-- The colored rail is the left 420px in both views; the right of it is the stage or the library. -->
    <view name="screen">
        <controllerActivity name="controllerActivity"><visible>false</visible></controllerActivity>
        <!-- Native Wi-Fi and battery indicators sit at the top right, inside the stage or preview panel. -->
        <batteryIndicator name="batteryIndicator">
            <pos>0.885416667 0.033333333</pos><size>0.088541667 0.044444444</size>
            <horizontalAlignment>right</horizontalAlignment><itemSpacing>0.003645833</itemSpacing>
            <color>${ink}</color><visible>true</visible>
        </batteryIndicator>
        <text name="clock"><pos>1 1</pos></text>
    </view>

    <view name="system, gamecarousel">
        <image name="canvas" extra="true">
            <path>${themePath}/assets/ui/white.svg</path>
            <pos>0 0</pos><size>1 1</size><color>${paper}</color><zIndex>0</zIndex>
        </image>
        <!-- The rail is drawn above the system carousel (zIndex 5): the carousel is three stages wide so a drag follows
             the finger, and the system to the left waits behind the rail until it is pulled into view. -->
        <image name="system-color-column" extra="true">
            <path>${themePath}/assets/ui/white.svg</path>
            <pos>0 0</pos><size>0.21875 1</size><color>${accent}</color><zIndex>7</zIndex>
        </image>
        <text name="hardware-manufacturer" extra="true">
            <text>${manufacturer}</text>
            <visible>${manufacturerTextVisible}</visible>
            <pos>0.010416667 0.055555556</pos><size>0.197916667 0.101851852</size>
            <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath><fontSize>0.044444444</fontSize>
            <color>${accentInk}</color><alignment>center</alignment><verticalAlignment>center</verticalAlignment><lineSpacing>1</lineSpacing><zIndex>8</zIndex>
        </text>
        <!-- Monochrome marks follow the same palette ink as the text they replace. -->
        <image name="manufacturer-logo" extra="true">
            <path>${manufacturerLogo}</path><visible>${manufacturerLogoVisible}</visible>
            <pos>0.109375 0.106481481</pos><origin>0.5 0.5</origin><maxSize>0.15625 0.101851852</maxSize>
            <color>${accentInk}</color><linearSmooth>true</linearSmooth><zIndex>8</zIndex>
        </image>
        <image name="platform-logo" extra="true">
            <path>${platformLogo}</path><visible>${platformLogoVisible}</visible>
            <pos>0.109375 0.486111111</pos><origin>0.5 0.5</origin><maxSize>0.177083333 0.203703704</maxSize>
            <color>${accentInk}</color><linearSmooth>true</linearSmooth><zIndex>8</zIndex>
        </image>
        <text name="hardware-year" extra="true">
            <text>${hardwareYear}</text><emptyTextDefaults>false</emptyTextDefaults>
            <pos>0.010416667 0.638888889</pos><size>0.197916667 0.055555556</size>
            <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath><fontSize>0.044444444</fontSize>
            <color>${accentInk}</color><alignment>center</alignment><verticalAlignment>center</verticalAlignment><zIndex>8</zIndex>
        </text>
        <!-- The on-screen name is a joke on the parent theme: one screen, one pop. The project is still Multi Pop. -->
        <text name="brand-caption" extra="true">
            <text>SINGLE POP</text>
            <pos>0.010416667 0.888888889</pos><size>0.197916667 0.040740741</size>
            <fontPath>${themePath}/assets/fonts/RobotoCondensed-Bold.ttf</fontPath><fontSize>0.033333333</fontSize>
            <color>${accentInk}</color><alignment>center</alignment><zIndex>8</zIndex>
        </text>
        <!-- The installed release number tells players which version they are running. -->
        <text name="version-caption" extra="true">
            <text>VERSION ${multiPopVersion}</text>
            <pos>0.010416667 0.931481481</pos><size>0.197916667 0.033333333</size>
            <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath><fontSize>0.025925926</fontSize>
            <color>${accentInk}</color><alignment>center</alignment><zIndex>8</zIndex>
        </text>
        <!-- Native hints would run under the stage and the rail, so each view writes its own short footer instead. -->
        <helpsystem name="help"><textColor>00000000</textColor><iconColor>00000000</iconColor></helpsystem>
    </view>
</theme>
