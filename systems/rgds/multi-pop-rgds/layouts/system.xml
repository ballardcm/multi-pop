<?xml version='1.0' encoding='utf-8'?>
<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <text name="browse-hints" extra="true">
      <text>‹ › browse · A select · START menu</text>
    </text>
    <text name="system-header" extra="true">
      <text>Systems</text>
      <pos>0.679166667 0.025000000</pos>
      <size>0.308333333 0.066666667</size>
      <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath>
      <fontSize>0.05416666666666667</fontSize>
      <color>${accentInk}</color>
      <alignment>left</alignment>
      <zIndex>3</zIndex>
    </text>
    <image name="system-hero" extra="true">
      <path>${systemIcon}</path>
      <pos>0.500000000 0.520833333</pos>
      <origin>0.5 0.5</origin>
      <zIndex>3</zIndex>
      <maxSize>0.308333333 0.729166667</maxSize>
      <linearSmooth>true</linearSmooth>
    </image>
    <text name="hero-instruction" extra="true">
      <text>Swipe either screen · Tap to select</text>
      <pos>0.345833333 0.931250000</pos>
      <size>0.308333333 0.054166667</size>
      <fontPath>${themePath}/assets/fonts/Roboto-Regular.ttf</fontPath>
      <fontSize>0.0375</fontSize>
      <color>${muted}</color>
      <alignment>center</alignment>
      <zIndex>3</zIndex>
    </text>
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0.833333333 0.450000000</pos>
      <origin>0.5 0.5</origin>
      <size>0.333333334 0.600000000</size>
      <logoSize>0.083333333 0.462962963</logoSize>
      <logoScale>1.15</logoScale>
      <maxLogoCount>3</maxLogoCount>
      <minLogoOpacity>0.8</minLogoOpacity>
      <color>00000000</color>
      <systemInfoDelay>0</systemInfoDelay>
      <zIndex>5</zIndex>
    </carousel>
    <image name="logo">
      <path>${systemCard}</path>
      <linearSmooth>true</linearSmooth>
    </image>
    <text name="logoText">
      <visible>false</visible>
    </text>
    <text name="selected-system-name" extra="true">
      <text>{system:collection} ? proper({system:fullName}) : {system:fullName}</text>
      <pos>0.679166667 0.762500000</pos>
      <size>0.308333333 0.083333333</size>
      <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath>
      <fontSize>0.05416666666666667</fontSize>
      <lineSpacing>1</lineSpacing>
      <color>${ink}</color>
      <alignment>center</alignment>
      <zIndex>6</zIndex>
    </text>
    <text name="systemInfo">
      <pos>0.679166667 0.854166667</pos>
      <size>0.308333333 0.050000000</size>
      <fontPath>${themePath}/assets/fonts/Roboto-Regular.ttf</fontPath>
      <fontSize>0.0375</fontSize>
      <color>${muted}</color>
      <alignment>center</alignment>
      <zIndex>6</zIndex>
    </text>
    <text name="hardware-heading" extra="true">
      <text>${manufacturer} · ${hardwareTitle} · ${hardwareYear}</text>
      <pos>0.345833333 0.025000000</pos>
      <size>0.229166667 0.116666667</size>
      <fontPath>${themePath}/assets/fonts/Roboto-Bold.ttf</fontPath>
      <fontSize>0.041666666666666664</fontSize>
      <color>${accentInk}</color>
      <alignment>left</alignment>
      <verticalAlignment>top</verticalAlignment>
      <lineSpacing>1</lineSpacing>
      <zIndex>3</zIndex>
    </text>
    <image name="hardware-stage" extra="true">
      <path>${themePath}/assets/ui/hardware-stage.svg</path>
      <pos>0.345833333 0.170833333</pos>
      <size>0.308333333 0.691666667</size>
      <color>${accent}</color>
      <zIndex>2</zIndex>
      <linearSmooth>true</linearSmooth>
    </image>
    <image name="hardware-halo" extra="true">
      <path>${themePath}/assets/ui/hardware-halo.svg</path>
      <pos>0.368750000 0.208333333</pos>
      <size>0.262500000 0.616666667</size>
      <color>${paper}</color>
      <zIndex>2.5</zIndex>
      <linearSmooth>true</linearSmooth>
    </image>
  </view>
</theme>